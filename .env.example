NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Comma-separated, server-side admin allowlist. Never expose this in client code.
ADMIN_EMAILS=

# eBay seller API (server-only; never expose these values in client code)
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory.readonly
# Keep false until the eBay write scope has been granted and tested.
EBAY_WRITE_ENABLED=false
EBAY_WRITE_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory
EBAY_RUNAME=
EBAY_OAUTH_CALLBACK_URL=https://shop.brandycards.de/api/admin/ebay/oauth/callback

# PayPal server-side checkout (never expose these values in client code)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Customer emails via Resend (server-only; never expose these values).
# Without RESEND_API_KEY nothing is sent and the shop keeps working — the
# send step logs a line and returns. Set the key only after the sending
# domain has been verified at Resend, otherwise every message bounces.
RESEND_API_KEY=
EMAIL_FROM=BrandyCards <post@brandycards.de>
EMAIL_REPLY_TO=post@brandycards.de
# Base URL for links inside the emails.
SHOP_BASE_URL=https://shop.brandycards.de

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BrandyCards_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Loaded="Page_Loaded"
    KeyDown="Page_KeyDown">
    <Grid Background="Transparent">
        <Border x:Name="SetupSurface" Background="{ThemeResource AvatarSurfaceBrush}">
            <ScrollViewer x:Name="SetupScrollViewer" Padding="18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SetupPanel" Spacing="12">
                    <TextBlock Text="BrandyCards Avatar" FontSize="27" FontWeight="SemiBold" Foreground="{ThemeResource AvatarTextBrush}" />
                    <TextBlock Text="Der Avatar läuft als eigene Desktop-App und reagiert auf Ereignisse im Shop." TextWrapping="Wrap" Foreground="{ThemeResource AvatarMutedBrush}" />

                    <TextBlock Text="Shop-Adresse" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{ThemeResource AvatarTextBrush}" />
                    <TextBox x:Name="ShopUrlTextBox" TabIndex="0" AutomationProperties.Name="Shop-Adresse" PlaceholderText="http://localhost:3000" Foreground="{ThemeResource AvatarTextBrush}" PlaceholderForeground="{ThemeResource AvatarMutedBrush}" Background="{ThemeResource AvatarInputBrush}" BorderBrush="{ThemeResource AvatarStrokeBrush}" />

                    <TextBlock Text="Einmaliger Pairing-Code" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{ThemeResource AvatarTextBrush}" />
                    <TextBox x:Name="PairingCodeTextBox" TabIndex="1" AutomationProperties.Name="Einmaliger Pairing-Code" PlaceholderText="ABCDEF-GHIJKL" Foreground="{ThemeResource AvatarTextBrush}" PlaceholderForeground="{ThemeResource AvatarMutedBrush}" Background="{ThemeResource AvatarInputBrush}" BorderBrush="{ThemeResource AvatarStrokeBrush}" />
                    <TextBlock Text="Den Code erzeugst du im Shop unter Admin → Desktop-Verbindung. Er ist 10 Minuten gültig und wird nur einmal verwendet." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AvatarMutedBrush}" />

                    <Button x:Name="ConnectButton" TabIndex="2" AutomationProperties.Name="Desktop-Avatar verbinden" Content="Desktop-Avatar verbinden" Click="ConnectButton_Click" HorizontalAlignment="Stretch" Background="{ThemeResource AvatarAccentBrush}" Foreground="{ThemeResource AvatarAccentTextBrush}" BorderBrush="{ThemeResource AvatarAccentBrush}" />
                    <TextBlock x:Name="StatusTextBlock" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="{ThemeResource AvatarErrorBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="ConnectedSurface" Visibility="Collapsed" Background="{ThemeResource AvatarSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button x:Name="LauncherButton"
                    Grid.Row="0"
                    TabIndex="0"
                    Margin="8"
                    MinHeight="54"
                    HorizontalAlignment="Stretch"
                    Click="LauncherButton_Click"
                    AutomationProperties.AutomationId="AssistantLauncher"
                    AutomationProperties.Name="K.A.R.L. öffnen"
                    AutomationProperties.HelpText="Öffnet das Textpanel von K.A.R.L., der Kartenshop-Auskunft für Recherche und Lagebericht.">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="BrandyCards Assistant" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="LauncherSubtitleTextBlock" Text="Textpanel öffnen" FontSize="12" Foreground="{ThemeResource AvatarMutedBrush}" />
                    </StackPanel>
                    <FontIcon x:Name="LauncherChevronIcon" Grid.Column="2" Glyph="&#xE70D;" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Grid x:Name="AssistantPanel" Grid.Row="1" Visibility="Collapsed" Padding="16,4,16,16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="K.A.R.L." FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource AvatarTextBrush}" />
                        <!-- Der Name wird ausgeschrieben, sonst ist er nur eine Buchstabenfolge.
                             Der Zusatz zum Lesezugriff bleibt: Er ist die Zusage, unter der
                             dieses Panel überhaupt gebaut wurde. -->
                        <TextBlock Text="Kartenshop-Auskunft für Recherche und Lagebericht" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AvatarMutedBrush}" />
                        <TextBlock Text="Nur lesender Zugriff über fest definierte Funktionen" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource AvatarMutedBrush}" />
                    </StackPanel>
                    <Button x:Name="CloseAssistantButton"
                            Grid.Column="1"
                            TabIndex="1"
                            Width="40"
                            Height="40"
                            Click="CloseAssistantButton_Click"
                            AutomationProperties.Name="Textpanel schließen"
                            ToolTipService.ToolTip="Textpanel schließen">
                        <FontIcon Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="{ThemeResource AvatarAssistantBrush}" BorderBrush="{ThemeResource AvatarStrokeBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer x:Name="ConversationScrollViewer" Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Unterhaltung mit dem Assistant">
                        <StackPanel x:Name="ConversationPanel" Spacing="10" />
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2"
                           Text="Beispiele: „Was wurde zuletzt verkauft?“, „Zeig offene Angebote“ oder „Wie ist der eBay-Sync?“"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{ThemeResource AvatarMutedBrush}" />

                <TextBox x:Name="AssistantInputTextBox"
                         Grid.Row="3"
                         TabIndex="2"
                         MinHeight="72"
                         MaxLength="500"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         PlaceholderText="Nachricht an den Assistant"
                         PreviewKeyDown="AssistantInputTextBox_PreviewKeyDown"
                         AutomationProperties.Name="Nachricht an den BrandyCards Assistant"
                         AutomationProperties.HelpText="Formuliere eine Frage zu Verkäufen, Bestellungen, Angeboten, Bestand, Anfragen, eBay-Sync oder Statistik. Eingabetaste sendet, Alt und Eingabetaste fügen eine neue Zeile ein."
                         Foreground="{ThemeResource AvatarTextBrush}"
                         PlaceholderForeground="{ThemeResource AvatarMutedBrush}"
                         Background="{ThemeResource AvatarInputBrush}"
                         BorderBrush="{ThemeResource AvatarStrokeBrush}" />

                    <Grid Grid.Row="4" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ProgressRing x:Name="AssistantProgressRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                            <TextBlock x:Name="AssistantStatusTextBlock" AutomationProperties.LiveSetting="Polite" Text="Bereit" TextWrapping="Wrap" Foreground="{ThemeResource AvatarMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="DictateAssistantButton"
                                Grid.Column="1"
                                TabIndex="3"
                                Width="44"
                                MinHeight="40"
                                Click="DictateAssistantButton_Click"
                                AutomationProperties.Name="Text diktieren"
                                AutomationProperties.HelpText="Startet eine einmalige lokale Windows-Spracheingabe. Der erkannte Text wird wie eine geschriebene Frage an den Assistant übergeben."
                                ToolTipService.ToolTip="Text lokal diktieren">
                            <FontIcon Glyph="&#xE720;" />
                        </Button>
                        <Button x:Name="SendAssistantButton"
                            Grid.Column="2"
                            TabIndex="4"
                            Content="Senden"
                            Click="SendAssistantButton_Click"
                            AutomationProperties.Name="Nachricht senden"
                            Background="{ThemeResource AvatarAccentBrush}"
                            Foreground="{ThemeResource AvatarAccentTextBrush}"
                            BorderBrush="{ThemeResource AvatarAccentBrush}" />
                </Grid>

                <Button x:Name="ChangeConnectionButton"
                        Grid.Row="5"
                        TabIndex="5"
                        Content="Verbindung ändern"
                        HorizontalAlignment="Left"
                        Click="ChangeConnectionButton_Click"
                        AutomationProperties.Name="Verbindung zum Shop ändern" />
            </Grid>
        </Grid>

        <Grid x:Name="AvatarPanel" Visibility="Collapsed" Background="Transparent">
            <Canvas x:Name="SpriteViewport" Width="192" Height="208" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas.Clip>
                    <RectangleGeometry Rect="0,0,192,208" />
                </Canvas.Clip>
                <Image x:Name="SpriteImage" Width="1536" Height="1872" Stretch="None" IsHitTestVisible="False" />
            </Canvas>

            <Button x:Name="SettingsButton"
                    Content="⚙"
                    Width="30"
                    Height="30"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Click="ChangeConnectionButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    BorderBrush="Transparent"
                    Opacity="0.8"
                    ToolTipService.ToolTip="Verbindung ändern" />
        </Grid>
    </Grid>
</Page>

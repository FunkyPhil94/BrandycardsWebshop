# Copy to wrangler.toml only when deploying the Worker through Wrangler.
# This file is a safe template: it contains no secrets and no domain routes.
# Replace the account and resource IDs before using it for another account.
"$schema" = "./node_modules/wrangler/config-schema.json"

name = "brandycards-webshop"
account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
main = "worker/index.ts"
compatibility_date = "2026-08-05"
compatibility_flags = ["nodejs_compat"]

[triggers]
crons = ["0 * * * *"]

[assets]
binding = "ASSETS"

[images]
binding = "IMAGES"

[[d1_databases]]
binding = "DB"
database_name = "brandycards-production"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[[r2_buckets]]
binding = "UPLOADS"
bucket_name = "brandycards-uploads"
